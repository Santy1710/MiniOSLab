{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar demo_procesos (padre)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/demo_procesos",
            "args": ["data/trabajos.txt", "--seq"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Compilar (make)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Depurar demo_procesos (seguir al hijo)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/demo_procesos",
            "args": ["data/trabajos.txt", "--seq"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Compilar (make)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-gdb-set follow-fork-mode child",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
